# Copy to .env and fill in real values for local development.
# docker-compose.yml's default ports match these hosts/ports out of the box.

# --- app (app/main.py) ---
# Comma-separated allowlist of origins allowed to call this API
# cross-origin - e.g. a frontend served from a different host/port during
# local development. "*" (the default) allows any origin; see the
# CORSMiddleware comment in app/main.py for why allow_credentials stays
# False alongside that default.
APP_CORS_ORIGINS=*

# --- Authentication (infrastructure/auth.py) ---
# WorkOS AuthKit is the recommended managed identity provider. The API accepts
# its short-lived access-token JWTs and verifies them locally from the public
# JWKS endpoint; no WorkOS API secret belongs in this backend.
#
# Create a WorkOS application, replace client_YOUR_CLIENT_ID below, and send
# `Authorization: Bearer <access_token>` on protected /agents and /documents
# requests. For a WorkOS custom auth domain, use its exact issuer instead.
APP_ENV=production
AUTH_MODE=jwt
AUTH_PROVIDER=workos
AUTH_ISSUER=https://api.workos.com
# Expected token target: checked against either `aud` or WorkOS `client_id`.
AUTH_AUDIENCE=client_YOUR_CLIENT_ID
AUTH_JWKS_URL=https://api.workos.com/sso/jwks/client_YOUR_CLIENT_ID
AUTH_JWT_ALGORITHMS=RS256
AUTH_JWKS_CACHE_SECONDS=300
AUTH_JWKS_TIMEOUT_SECONDS=10
AUTH_CLOCK_SKEW_SECONDS=30

# Explicit local bypass (never the production default). To use it, comment the
# production values above and enable all three lines; AUTH_MODE=development is
# rejected unless APP_ENV is exactly "development".
# APP_ENV=development
# AUTH_MODE=development
# AUTH_DEV_USER_ID=local-dev

# --- Infrastructure ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ai_agent_platform
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# --- LLM provider (infrastructure/llm.py) ---
# "ollama" (default, local) or "mistralai" (remote, needs MISTRAL_API_KEY
# below) - see _build_llm_provider() in app/lifespan.py.
LLM_PROVIDER=ollama
# Process-wide default inherited by agents whose temperature is null.
# Individual agents may override it from 0 through 2.
LLM_TEMPERATURE=0.3

# qwen3:8b - reliable tool-calling in a size that fits 16GB RAM comfortably.
# gpt-oss:20b was tried and reverted: ~13GB alone, leaving almost no
# headroom on 16-17GB unified memory - real-world reports of 50s+ for a
# two-sentence reply without a GPU with 20GB+ VRAM. `ollama pull qwen3:8b`
# if you don't have it yet.
#
# Want a much larger model without local VRAM to run it? Ollama also proxies
# hosted "cloud" models through this same client/base URL - e.g.
# OLLAMA_MODEL=minimax-m3:cloud (428B MoE, ~23B active params, up to 1M
# token context, US-hosted with zero data retention per Ollama - launched
# 2026-06-01). One-time `ollama signin` required; LLM_PROVIDER stays
# "ollama" either way, no code change. Treat its free-tier durability as
# unverified - re-check https://ollama.com/library/minimax-m3:cloud before
# depending on it, unlike qwen3:8b's fully local/no-account default.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Reasoning effort for models that support it (qwen3 does). Unset lets the
# model use its own default; "false" turns chain-of-thought off entirely
# for lower latency; "low"/"medium"/"high" tunes effort instead of an
# on/off switch. Applies to every call - see infrastructure/llm.py's
# OllamaProvider docstring.
OLLAMA_REASONING=false
# How long Ollama keeps qwen3:8b loaded in memory after the last request -
# a duration string ("30m", "1h") or "-1" for indefinitely. Avoids paying
# the model-load cost again on the next chat turn. Ollama's own default is
# "5m" if unset here.
OLLAMA_KEEP_ALIVE=30m

# Remote alternative to Ollama - only used when LLM_PROVIDER=mistralai.
# mistral-medium-latest ("frontier-class multimodal model optimized for
# agentic and coding use cases" per Mistral's own docs) is reachable on
# Mistral's free "Experiment" plan as of this writing - rate-limited, not
# metered per token, no local RAM/GPU needed at all. A free tier's exact
# model coverage can change without notice, though - confirm current
# entitlement at https://console.mistral.ai/ before relying on it, and drop
# back to mistral-small-latest (the older, long-confirmed free-tier choice)
# if your account doesn't have medium. Get a key at
# https://console.mistral.ai/ - never commit a real one.
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-medium-latest

# --- Embedding provider (infrastructure/llm.py's OllamaEmbedder) ---
# bge-m3 (BAAI, MIT license, ~1.2GB, `ollama pull bge-m3`) - dense+sparse+
# multi-vector retrieval in one model, 8,192-token context (unlike
# mxbai-embed-large's 512-token cap, which silently truncates anything
# longer - a real risk here since IngestDocumentRequest.chunk_size has no
# enforced upper bound). Used by rag's ingest/search endpoints to embed
# text before writing to/querying Qdrant.
#
# Changing this after documents are already indexed is a breaking change,
# not a hot-swap: Qdrant's collection is created once with whatever vector
# dimensionality the first-ever embedding had
# (QdrantVectorStore.ensure_collection), and a different embedding model
# almost certainly produces a different dimensionality - upserts into the
# existing collection will fail. Either re-ingest everything after
# switching, or point QDRANT_COLLECTION at a fresh collection name.
OLLAMA_EMBEDDING_MODEL=bge-m3

# --- Generated artifacts (shared/artifacts.py) ---
# PDF/Markdown generation and editing tools write new output only beneath this
# directory and return read-only download URLs under /artifacts. Relative paths
# resolve from the process working directory. Generated files are ignored by git.
ARTIFACTS_DIR=artifacts
