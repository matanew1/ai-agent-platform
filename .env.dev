# Local development template. Copy to .env:
#   cp .env.dev .env
# then fill in WORKOS_COOKIE_PASSWORD (and WORKOS_API_KEY/WORKOS_CLIENT_ID if
# you don't have them yet). docker-compose.yml's default ports match these
# hosts/ports out of the box - `docker compose up -d` before `uv run app`.
#
# See AUTHENTICATION.md for the full dev-vs-prod auth setup, including the
# WorkOS Dashboard steps this file alone can't do for you.

# --- app (app/main.py) ---
# Only the frontend's own origin - never "*" now that authentication.
# controller issues a session cookie (allow_credentials=True always on).
APP_CORS_ORIGINS=http://localhost:5173

APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true

LOG_LEVEL=INFO
LOG_COLOR=auto

# --- Authentication (modules/authentication) ---
# APP_ENV=development relaxes two things AUTH_MODE=workos still needs even
# in dev: AUTH_REDIRECT_URI is allowed to be http:// instead of https://,
# and the session/login-state cookies are issued SameSite=Lax without
# Secure (both would otherwise be rejected/dropped by the browser over
# plain HTTP - see AUTHENTICATION.md's cookie-policy table).
APP_ENV=development
AUTH_MODE=workos
AUTH_DEV_USER_ID=local-dev

# From your WorkOS Dashboard (Sandbox/Development environment).
WORKOS_CLIENT_ID=client_YOUR_CLIENT_ID
WORKOS_API_KEY=sk_test_YOUR_API_KEY
# openssl rand -base64 32 - distinct secret from WORKOS_API_KEY, never
# sent to the frontend, never committed.
WORKOS_COOKIE_PASSWORD=
# Must be registered verbatim under WorkOS Dashboard > Redirects >
# Redirect URIs, or /auth/login's authorize call is rejected.
AUTH_REDIRECT_URI=http://localhost:8000/auth/callback
# Must also be registered under WorkOS Dashboard > Redirects (Sign-out
# redirect, at minimum).
AUTH_FRONTEND_URL=http://localhost:5173

# Alternative to the two lines above: skip WorkOS entirely for offline
# local dev (no Dashboard access needed). Comment out AUTH_MODE=workos
# above and uncomment this instead - every request is authenticated as
# AUTH_DEV_USER_ID with no cookie/WorkOS round-trip at all.
# AUTH_MODE=development

# --- Infrastructure (docker-compose.yml defaults) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_agent_platform
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# --- Ollama (infrastructure/llm/ollama.py) ---
LLM_TEMPERATURE=0.3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_REASONING=false
OLLAMA_KEEP_ALIVE=30m
OLLAMA_EMBEDDING_MODEL=bge-m3
