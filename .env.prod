# Production template. Set these as real environment variables on your
# hosting platform (Fly/Render/ECS/whatever) - don't ship this file itself,
# and never commit filled-in values. See AUTHENTICATION.md for the full
# dev-vs-prod auth setup and the WorkOS Dashboard steps this file can't do
# for you.

# --- app (app/main.py) ---
# Your real frontend origin(s), comma-separated if more than one. Never
# "*" - authentication.controller issues a session cookie
# (allow_credentials=True is always on), so a wildcard here would let any
# website ride a signed-in user's session.
APP_CORS_ORIGINS=https://app.yourdomain.com

APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false

LOG_LEVEL=INFO
LOG_COLOR=auto

# --- Authentication (modules/authentication) ---
# APP_ENV must be anything other than "development" in production - it's
# what enforces AUTH_REDIRECT_URI being https:// and the session/
# login-state cookies being issued Secure + SameSite=None (required for a
# frontend and backend on different domains, which is the normal
# production topology - see AUTHENTICATION.md's cookie-policy table).
# AUTH_MODE=development is refused outright unless APP_ENV=development, so
# there's no way to accidentally ship the local dev bypass live.
APP_ENV=production
AUTH_MODE=workos

# From your WorkOS Dashboard (Production environment - a separate set of
# credentials from Sandbox/Development).
WORKOS_CLIENT_ID=client_YOUR_PRODUCTION_CLIENT_ID
WORKOS_API_KEY=sk_live_YOUR_PRODUCTION_API_KEY

# openssl rand -base64 32 - generate a fresh one for production, don't
# reuse the dev value. Rotating it invalidates every existing session.
WORKOS_COOKIE_PASSWORD=

# Must be https:// and registered verbatim under WorkOS Dashboard >
# Redirects > Redirect URIs (Production environment).
AUTH_REDIRECT_URI=https://api.yourdomain.com/auth/callback
# Must also be registered under WorkOS Dashboard > Redirects (Sign-out
# redirect, at minimum) - the origin /auth/login and /auth/logout send
# the browser back to.
AUTH_FRONTEND_URL=https://app.yourdomain.com

# --- Infrastructure ---
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/ai_agent_platform
REDIS_URL=redis://HOST:6379/0
QDRANT_URL=https://HOST:6333
QDRANT_COLLECTION=documents

# --- Ollama (infrastructure/llm/ollama.py) ---
# Point at a reachable Ollama instance, or Ollama's hosted "cloud" models
# through the same client - see .env.example's OLLAMA_MODEL comment.
LLM_TEMPERATURE=0.3
OLLAMA_BASE_URL=http://YOUR_OLLAMA_HOST:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_REASONING=false
OLLAMA_KEEP_ALIVE=30m
OLLAMA_EMBEDDING_MODEL=bge-m3
